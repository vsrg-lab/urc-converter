<ui:FluentWindow x:Class="UrcConverter.Gui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="URC Converter"
                 Width="1200" Height="780"
                 MinWidth="920" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 AllowDrop="True"
                 DragOver="Window_DragOver"
                 Drop="Window_Drop">
	<ui:FluentWindow.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />

		<Style x:Key="InvertedBoolToVis" TargetType="FrameworkElement">
			<Setter Property="Visibility" Value="Visible" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding HasFile}" Value="True">
					<Setter Property="Visibility" Value="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="PillBadge" TargetType="Border">
			<Setter Property="CornerRadius" Value="5" />
			<Setter Property="Padding" Value="8,3" />
			<Setter Property="Margin" Value="0,0,6,0" />
			<Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<Style x:Key="MetricTile" TargetType="Border">
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="10,7" />
			<Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<Style x:Key="PresetButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="4,0,0,0" />
		</Style>
	</ui:FluentWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Title bar -->
		<ui:TitleBar Grid.Row="0" Title="URC Converter 0.4.0" ShowMaximize="True" />

		<!-- Top toolbar: file actions + playback rate bar -->
		<Border Grid.Row="1"
		        BorderThickness="0,0,0,1"
		        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
		        Padding="16,10">
			<DockPanel LastChildFill="False">
				<StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
					<ui:Button Appearance="Primary"
					           Icon="{ui:SymbolIcon FolderOpen24}"
					           Content="Open…"
					           Command="{Binding OpenFileCommand}" />
					<ui:Button Margin="8,0,0,0"
					           Icon="{ui:SymbolIcon Save24}"
					           Content="Save as URC…"
					           Command="{Binding SaveCommand}" />
					<ui:Button Margin="8,0,0,0"
					           Icon="{ui:SymbolIcon Copy24}"
					           Content="Copy"
					           Command="{Binding CopyPreviewCommand}" />
				</StackPanel>

				<!-- Playback rate controls (0.50x..3.00x, 0.01 step) -->
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="Rate"
					           FontWeight="SemiBold"
					           VerticalAlignment="Center"
					           Margin="0,0,8,0"
					           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
					<ui:Button Content="−"
					           Padding="8,4"
					           ToolTip="Decrease rate by 0.01x"
					           Command="{Binding StepRateCommand}"
					           CommandParameter="-0.01" />
					<Slider Width="130"
					        Margin="8,0"
					        VerticalAlignment="Center"
					        Minimum="0.50"
					        Maximum="3.00"
					        SmallChange="0.01"
					        LargeChange="0.10"
					        TickFrequency="0.01"
					        IsSnapToTickEnabled="True"
					        Value="{Binding Rate, Mode=TwoWay}" />
					<ui:Button Content="+"
					           Padding="8,4"
					           ToolTip="Increase rate by 0.01x"
					           Command="{Binding StepRateCommand}"
					           CommandParameter="0.01" />
					<ui:TextBox Width="68"
					            Margin="8,0,0,0"
					            Padding="8,4"
					            HorizontalContentAlignment="Center"
					            FontFamily="Cascadia Mono,Consolas,Courier New"
					            Text="{Binding RateText, UpdateSourceTrigger=LostFocus}"
					            KeyDown="RateTextBox_KeyDown"
					            ToolTip="Playback rate (0.50 to 3.00, 0.01 step)" />
					<Border Margin="8,0,4,0"
					        Width="1"
					        Height="20"
					        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
					<ui:Button Style="{StaticResource PresetButton}" Content="0.75x" Command="{Binding SetRatePresetCommand}" CommandParameter="0.75" />
					<ui:Button Style="{StaticResource PresetButton}" Content="1.00x" Command="{Binding ResetRateCommand}" />
					<ui:Button Style="{StaticResource PresetButton}" Content="1.25x" Command="{Binding SetRatePresetCommand}" CommandParameter="1.25" />
					<ui:Button Style="{StaticResource PresetButton}" Content="1.50x" Command="{Binding SetRatePresetCommand}" CommandParameter="1.50" />
					<ui:Button Style="{StaticResource PresetButton}" Content="2.00x" Command="{Binding SetRatePresetCommand}" CommandParameter="2.00" />
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- Main content area -->
		<Grid Grid.Row="2" Margin="16,12,16,10">
			<!-- Empty state drop zone -->
			<Grid Style="{StaticResource InvertedBoolToVis}">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<ui:InfoBar Grid.Row="0"
				            Margin="0,0,0,12"
				            Severity="Error"
				            Title="Conversion failed"
				            Message="{Binding ErrorMessage}"
				            IsOpen="{Binding IsError, Mode=OneWay}"
				            IsClosable="False" />

				<Border Grid.Row="1"
				        CornerRadius="12"
				        BorderThickness="1.5"
				        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
				        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
				        HorizontalAlignment="Center"
				        VerticalAlignment="Center"
				        Padding="52,44"
				        MaxWidth="560">
					<StackPanel HorizontalAlignment="Center">
						<ui:SymbolIcon Symbol="DocumentAdd24"
						               FontSize="44"
						               HorizontalAlignment="Center"
						               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
						<TextBlock Text="Drop a rhythm game chart here"
						           FontSize="20"
						           FontWeight="SemiBold"
						           HorizontalAlignment="Center"
						           Margin="0,16,0,6" />
						<TextBlock Text="Converts to canonical URC 1.1 with optional 0.50x–3.00x playback rate scaling."
						           TextWrapping="Wrap"
						           TextAlignment="Center"
						           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
						           Margin="0,0,0,20" />
						<WrapPanel HorizontalAlignment="Center" Margin="0,0,0,22">
							<Border Style="{StaticResource PillBadge}"><TextBlock Text=".osu" FontFamily="Cascadia Mono,Consolas" FontSize="12" /></Border>
							<Border Style="{StaticResource PillBadge}"><TextBlock Text=".qua" FontFamily="Cascadia Mono,Consolas" FontSize="12" /></Border>
							<Border Style="{StaticResource PillBadge}"><TextBlock Text=".bms / .bme / .bml / .pms" FontFamily="Cascadia Mono,Consolas" FontSize="12" /></Border>
							<Border Style="{StaticResource PillBadge}"><TextBlock Text=".sm / .ssc" FontFamily="Cascadia Mono,Consolas" FontSize="12" /></Border>
							<Border Style="{StaticResource PillBadge}"><TextBlock Text=".ojn" FontFamily="Cascadia Mono,Consolas" FontSize="12" /></Border>
							<Border Style="{StaticResource PillBadge}" Margin="0"><TextBlock Text=".urc" FontFamily="Cascadia Mono,Consolas" FontSize="12" /></Border>
						</WrapPanel>
						<ui:Button Appearance="Primary"
						           HorizontalAlignment="Center"
						           Padding="18,8"
						           Icon="{ui:SymbolIcon FolderOpen24}"
						           Content="Choose File…"
						           Command="{Binding OpenFileCommand}" />
					</StackPanel>
				</Border>
			</Grid>

			<!-- Loaded workspace -->
			<Grid Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="300" MinWidth="230" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<!-- Left sidebar: file info, chart selector, BMS options -->
				<DockPanel Grid.Column="0" Margin="0,0,10,0">
					<ui:Card DockPanel.Dock="Top" Padding="12,10" Margin="0,0,0,12">
						<DockPanel>
							<ui:SymbolIcon DockPanel.Dock="Left"
							               Symbol="Document24"
							               FontSize="20"
							               Margin="0,0,10,0"
							               VerticalAlignment="Center"
							               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
							<StackPanel>
								<TextBlock Text="{Binding FileName}"
								           FontWeight="SemiBold"
								           TextTrimming="CharacterEllipsis"
								           ToolTip="{Binding FilePath}" />
								<TextBlock Text="{Binding FilePath}"
								           FontSize="11.5"
								           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
								           TextTrimming="CharacterEllipsis"
								           ToolTip="{Binding FilePath}" />
							</StackPanel>
						</DockPanel>
					</ui:Card>

					<StackPanel DockPanel.Dock="Bottom"
					            Margin="0,12,0,0"
					            Visibility="{Binding IsBmsSource, Converter={StaticResource BoolToVis}}">
						<ui:Card Padding="12">
							<StackPanel>
								<TextBlock Text="BMS #RANDOM options" FontWeight="SemiBold" Margin="0,0,0,8" />
								<ui:TextBox PlaceholderText="Seed (e.g. 42)"
								            Text="{Binding SeedText, UpdateSourceTrigger=LostFocus}"
								            Margin="0,0,0,8" />
								<ui:TextBox PlaceholderText="Branch picks (e.g. 2,1)"
								            Text="{Binding BranchesText, UpdateSourceTrigger=LostFocus}"
								            Margin="0,0,0,8" />
								<ui:Button HorizontalAlignment="Stretch"
								           Content="Apply branch options"
								           Command="{Binding ApplyBmsOptionsCommand}" />
							</StackPanel>
						</ui:Card>
					</StackPanel>

					<DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
						<TextBlock DockPanel.Dock="Left" Text="Charts" FontWeight="SemiBold" VerticalAlignment="Center" />
						<TextBlock DockPanel.Dock="Right"
						           Text="{Binding Charts.Count, StringFormat={}{0} total}"
						           FontSize="12"
						           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
						           VerticalAlignment="Center" />
					</DockPanel>

					<ui:ListView ItemsSource="{Binding Charts}"
					             SelectedItem="{Binding SelectedChart}"
					             HorizontalContentAlignment="Stretch"
					             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ui:ListView.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal" Margin="2,4">
									<Border CornerRadius="4"
									        Background="{DynamicResource ControlFillColorSecondaryBrush}"
									        Padding="7,2"
									        MinWidth="26">
										<TextBlock Text="{Binding Index}"
										           FontFamily="Cascadia Mono,Consolas"
										           FontSize="12"
										           HorizontalAlignment="Center" />
									</Border>
									<TextBlock Text="{Binding Name}"
									           Margin="10,0,0,0"
									           VerticalAlignment="Center"
									           TextTrimming="CharacterEllipsis" />
								</StackPanel>
							</DataTemplate>
						</ui:ListView.ItemTemplate>
					</ui:ListView>
				</DockPanel>

				<GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeBehavior="CurrentAndNext" />

				<!-- Right main panel: banners, summary card, preview card -->
				<Grid Grid.Column="2" Margin="10,0,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!-- Error InfoBar -->
					<ui:InfoBar Grid.Row="0"
					            Margin="0,0,0,10"
					            Severity="Error"
					            Title="Error"
					            Message="{Binding ErrorMessage}"
					            IsOpen="{Binding IsError, Mode=OneWay}"
					            IsClosable="False" />

					<!-- Warning InfoBar + expandable details -->
					<StackPanel Grid.Row="1"
					            Margin="0,0,0,10"
					            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
						<ui:InfoBar Severity="Warning"
						            Title="{Binding WarningBannerTitle}"
						            Message="{Binding WarningBannerMessage}"
						            IsOpen="{Binding HasWarnings, Mode=OneWay}"
						            IsClosable="False" />
						<Expander Header="View all adjustment warnings"
						          Margin="0,4,0,0"
						          IsExpanded="False">
							<ListBox ItemsSource="{Binding Warnings}"
							         MaxHeight="130"
							         Background="Transparent"
							         BorderThickness="0"
							         FontFamily="Cascadia Mono,Consolas,Courier New"
							         FontSize="11.5">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Expander>
					</StackPanel>

					<!-- Structured Summary Card -->
					<ui:Card Grid.Row="2" Padding="14,12" Margin="0,0,0,10">
						<StackPanel>
							<DockPanel Margin="0,0,0,10">
								<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
									<Border Style="{StaticResource PillBadge}">
										<TextBlock Text="{Binding SummaryOriginal}" FontSize="12" FontWeight="SemiBold" />
									</Border>
									<Border Style="{StaticResource PillBadge}">
										<TextBlock Text="{Binding SummaryLayout}" FontSize="12" FontFamily="Cascadia Mono,Consolas" />
									</Border>
									<Border Style="{StaticResource PillBadge}">
										<TextBlock Text="{Binding SummaryBpm}" FontSize="12" FontFamily="Cascadia Mono,Consolas" />
									</Border>
									<Border Style="{StaticResource PillBadge}">
										<TextBlock Text="{Binding RateBadgeText}"
										           FontSize="12"
										           FontWeight="SemiBold"
										           FontFamily="Cascadia Mono,Consolas"
										           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
									</Border>
									<Border Style="{StaticResource PillBadge}" Margin="0">
										<TextBlock Text="{Binding SummaryFormatVersion}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
									</Border>
								</StackPanel>

								<StackPanel Margin="0,0,12,0">
									<TextBlock Text="{Binding SummaryTitle}"
									           FontSize="17"
									           FontWeight="SemiBold"
									           TextTrimming="CharacterEllipsis" />
									<TextBlock Text="{Binding SummarySubtitle}"
									           FontSize="12.5"
									           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
									           TextTrimming="CharacterEllipsis"
									           Margin="0,2,0,0" />
								</StackPanel>
							</DockPanel>

							<UniformGrid Columns="7">
								<Border Style="{StaticResource MetricTile}" Margin="0,0,6,0">
									<StackPanel>
										<TextBlock Text="TIMING" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
										<TextBlock Text="{Binding SummaryTimingCount, StringFormat={}{0:N0}}" FontSize="14" FontWeight="SemiBold" FontFamily="Cascadia Mono,Consolas" />
									</StackPanel>
								</Border>
								<Border Style="{StaticResource MetricTile}" Margin="0,0,6,0">
									<StackPanel>
										<TextBlock Text="TOTAL" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
										<TextBlock Text="{Binding SummaryTotalNotes, StringFormat={}{0:N0}}" FontSize="14" FontWeight="SemiBold" FontFamily="Cascadia Mono,Consolas" />
									</StackPanel>
								</Border>
								<Border Style="{StaticResource MetricTile}" Margin="0,0,6,0">
									<StackPanel>
										<TextBlock Text="NORMAL" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
										<TextBlock Text="{Binding SummaryNormal, StringFormat={}{0:N0}}" FontSize="14" FontWeight="SemiBold" FontFamily="Cascadia Mono,Consolas" />
									</StackPanel>
								</Border>
								<Border Style="{StaticResource MetricTile}" Margin="0,0,6,0">
									<StackPanel>
										<TextBlock Text="HOLD LS" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
										<TextBlock Text="{Binding SummaryHoldStart, StringFormat={}{0:N0}}" FontSize="14" FontWeight="SemiBold" FontFamily="Cascadia Mono,Consolas" />
									</StackPanel>
								</Border>
								<Border Style="{StaticResource MetricTile}" Margin="0,0,6,0">
									<StackPanel>
										<TextBlock Text="HOLD LE" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
										<TextBlock Text="{Binding SummaryHoldEnd, StringFormat={}{0:N0}}" FontSize="14" FontWeight="SemiBold" FontFamily="Cascadia Mono,Consolas" />
									</StackPanel>
								</Border>
								<Border Style="{StaticResource MetricTile}" Margin="0,0,6,0">
									<StackPanel>
										<TextBlock Text="MINE" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
										<TextBlock Text="{Binding SummaryMine, StringFormat={}{0:N0}}" FontSize="14" FontWeight="SemiBold" FontFamily="Cascadia Mono,Consolas" />
									</StackPanel>
								</Border>
								<Border Style="{StaticResource MetricTile}">
									<StackPanel>
										<TextBlock Text="FAKE" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
										<TextBlock Text="{Binding SummaryFake, StringFormat={}{0:N0}}" FontSize="14" FontWeight="SemiBold" FontFamily="Cascadia Mono,Consolas" />
									</StackPanel>
								</Border>
							</UniformGrid>
						</StackPanel>
					</ui:Card>

					<!-- Preview Card -->
					<Border Grid.Row="3"
					        CornerRadius="8"
					        BorderThickness="1"
					        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
					        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
						<DockPanel>
							<Border DockPanel.Dock="Top"
							        BorderThickness="0,0,0,1"
							        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
							        Padding="12,8">
								<DockPanel>
									<TextBlock DockPanel.Dock="Left"
									           Text="URC Preview"
									           FontWeight="SemiBold"
									           VerticalAlignment="Center" />
									<TextBlock DockPanel.Dock="Right"
									           Text="{Binding PreviewStats}"
									           FontSize="12"
									           FontFamily="Cascadia Mono,Consolas"
									           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
									           VerticalAlignment="Center" />
								</DockPanel>
							</Border>

							<TextBox Text="{Binding PreviewText, Mode=OneWay}"
							         IsReadOnly="True"
							         IsReadOnlyCaretVisible="True"
							         Background="Transparent"
							         BorderThickness="0"
							         Padding="12,10"
							         FontFamily="Cascadia Mono,Consolas,Courier New"
							         FontSize="12.5"
							         TextWrapping="NoWrap"
							         AcceptsReturn="True"
							         VerticalScrollBarVisibility="Auto"
							         HorizontalScrollBarVisibility="Auto" />
						</DockPanel>
					</Border>
				</Grid>
			</Grid>
		</Grid>

		<!-- Bottom status bar -->
		<Border Grid.Row="3"
		        BorderThickness="0,1,0,0"
		        BorderBrush="{DynamicResource DividerFillColorDefaultBrush}"
		        Padding="16,7">
			<DockPanel>
				<TextBlock DockPanel.Dock="Right"
				           Text="{Binding RateBadgeText, StringFormat=Rate: {0}}"
				           FontFamily="Cascadia Mono,Consolas"
				           FontSize="12"
				           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
				           Margin="16,0,0,0" />
				<TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsError}" Value="True">
									<Setter Property="Foreground" Value="#FF6E6E" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</DockPanel>
		</Border>
	</Grid>
</ui:FluentWindow>
