<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>CloudHolic</Authors>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Strings.fs" />
		<Compile Include="Error.fs" />
		<Compile Include="Model.fs" />
		<Compile Include="Parser\State.fs" />
		<Compile Include="Parser\Lex.fs" />
		<Compile Include="Parser\Fields.fs" />
		<Compile Include="Parser\Checks.fs" />
		<Compile Include="Parser\Assembly.fs" />
		<Compile Include="Parser\Scan.fs" />
		<Compile Include="Sources\Shared.fs" />
		<Compile Include="Sources\Bms\Model.fs" />
		<Compile Include="Sources\Bms\Parse.fs" />
		<Compile Include="Sources\Bms\Convert.fs" />
		<Compile Include="Sources\Osu\Model.fs" />
		<Compile Include="Sources\Osu\Parse.fs" />
		<Compile Include="Sources\Osu\Convert.fs" />
		<Compile Include="Sources\Qua\Model.fs" />
		<Compile Include="Sources\Qua\Parse.fs" />
		<Compile Include="Sources\Qua\Convert.fs" />
		<Compile Include="Writer.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FParsec" Version="1.1.1" />
		<PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

</Project>
