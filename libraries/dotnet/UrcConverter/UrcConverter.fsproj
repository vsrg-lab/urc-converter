<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>UrcConverter</PackageId>
		<Version>0.2.2</Version>
		<Authors>CloudHolic</Authors>
		<Description>URC (Universal Rhythm Chart) parser, serializer, playback rate scaler, and VSRG chart converter library.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/vsrg-lab/urc-converter</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>urc;rhythm-game;vsrg;chart;converter;osu;bms;stepmania;quaver;ojn</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="Strings.fs" />
		<Compile Include="Error.fs" />
		<Compile Include="Model.fs" />
		<Compile Include="Writer.fs" />
		<Compile Include="Rate.fs" />
		<Compile Include="Parser\State.fs" />
		<Compile Include="Parser\Lex.fs" />
		<Compile Include="Parser\Fields.fs" />
		<Compile Include="Parser\Checks.fs" />
		<Compile Include="Parser\Assembly.fs" />
		<Compile Include="Parser\Scan.fs" />
		<Compile Include="Urc.fs" />
		<Compile Include="Sources\Shared.fs" />
		<Compile Include="Sources\Bms\Model.fs" />
		<Compile Include="Sources\Bms\Parse.fs" />
		<Compile Include="Sources\Bms\Channels.fs" />
		<Compile Include="Sources\Bms\Convert.fs" />
		<Compile Include="Sources\Osu\Model.fs" />
		<Compile Include="Sources\Osu\Parse.fs" />
		<Compile Include="Sources\Osu\Convert.fs" />
		<Compile Include="Sources\Qua\Model.fs" />
		<Compile Include="Sources\Qua\Parse.fs" />
		<Compile Include="Sources\Qua\Convert.fs" />
		<Compile Include="Sources\Sm\Model.fs" />
		<Compile Include="Sources\Sm\Preprocess.fs" />
		<Compile Include="Sources\Sm\Msd.fs" />
		<Compile Include="Sources\Sm\Notes.fs" />
		<Compile Include="Sources\Sm\Parse.fs" />
		<Compile Include="Sources\Sm\Convert.fs" />
		<Compile Include="Sources\Ojn\Model.fs" />
		<Compile Include="Sources\Ojn\Parse.fs" />
		<Compile Include="Sources\Ojn\Convert.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

</Project>
