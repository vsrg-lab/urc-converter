{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/urc-converter.tsbuildinfo",
		"incremental": true,
		"target": "es2025",
		"lib": ["ES2025"],
		"types": ["node"],
		"skipLibCheck": true,

		/* Node ESM library (replaces bundler-mode noEmit settings) */
		"module": "nodenext",
		"moduleDetection": "force",
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,
	},
	"include": ["src"],
}
